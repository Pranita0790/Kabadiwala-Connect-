# Firebase client config for the collector app.
#
# Copy to .env (git-ignored) and fill in from
# Firebase Console > Project settings > Your apps.
#
# Run the app with:
#   flutter run --dart-define-from-file=.env
#
# These values are NOT secrets — Firebase documents client config as public.
# They are kept out of Git only so two branches cannot silently point at
# different Firebase projects. The backend's FIREBASE_PROJECT_ID must be the
# SAME project id as here.

FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
