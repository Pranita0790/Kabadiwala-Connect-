# ==============================
# Kabadiwala Connect .gitignore
# ==============================

# Environment / secrets
.env
.env.*
!.env.example

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# IDE / editors
.vscode/
.idea/
*.iml

# ==============================
# Python
# ==============================

__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Python packaging
build/
dist/
*.egg-info/

# ==============================
# Node.js
# ==============================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================
# React / Vite
# ==============================

apps/recycler-dashboard/dist/
apps/recycler-dashboard/.vite/

# ==============================
# Flutter / Dart
# ==============================

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

apps/collector/build/
apps/collector/.dart_tool/

# ==============================
# Android
# ==============================

.gradle/
android/.gradle/
android/local.properties

# ==============================
# iOS
# ==============================

ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/

# ==============================
# Test / coverage
# ==============================

coverage/
.pytest_cache/
htmlcov/

# ==============================
# Logs
# ==============================

*.log

# ==============================
# Temporary files
# ==============================

*.tmp
*.temp
*.swp
*~

# ==============================
# Local databases
# ==============================

*.sqlite
*.sqlite3
*.db

# ==============================
# Large ML artifacts
# ==============================

*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.ckpt
*.tflite

# ==============================
# Large datasets
# ==============================

data/raw/*
data/processed/*

# Keep directory documentation
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/class_mapping.csv
!data/processed/dataset_manifest.csv

# ==============================
# OS / generated files
# ==============================

.DS_Store
Thumbs.db
