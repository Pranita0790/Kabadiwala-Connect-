# =====================================================================
# Kabadiwala Connect — single project-wide environment file
#
# One file for the whole repo. Copy it once:
#     cp .env.example .env
# NEVER commit .env (AGENTS.md section 9). This template is committed and
# must contain no real secrets.
#
# Who reads it:
#   services/backend    Node/Express. Loaded by src/config/env.js.
#   apps/collector      Flutter. Passed at build time:
#                         cd apps/collector
#                         flutter run --dart-define-from-file=../../.env
#   services/ai-service No env vars yet; it will read this same file when
#                       it gains configuration.
#
# SECURITY: the Flutter build receives the WHOLE file. Only the uncommented
# FIREBASE_* keys below are read by the app; do not add backend-only secrets
# that you are unwilling to pass to the app compiler.
# =====================================================================


# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Comma-separated. Dashboard dev servers plus the deployed Vercel app.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://kabadiwala-connect-xi.vercel.app

# ---------------------------------------------------------------------
# PostgreSQL
#
# Either DATABASE_URL, or the discrete DB_* values below.
# ---------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@localhost:5432/kabadiwala
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kabadiwala
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_REQUIRED=true

# ---------------------------------------------------------------------
# Sessions — this backend's own JWTs, unrelated to Firebase's
# ---------------------------------------------------------------------
# MANDATORY in production. Generate with: openssl rand -hex 32
# JWT_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=kabadiwala-connect
JWT_AUDIENCE=kabadiwala-clients
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------
# Firebase Phone Auth
#
# FIREBASE_PROJECT_ID (backend) and FIREBASE_* (collector client) MUST point
# at the same Firebase project.
#
# The backend needs ONLY the project id. It verifies ID tokens against
# Google's public signing certificates, so there is deliberately no
# service-account key, private key, or admin credential here. If you find
# one, treat it as exposed and rotate it immediately.
#
# Unset project id means phone sign-in answers FIREBASE_NOT_CONFIGURED and
# GET /health/ready reports checks.phoneAuth.status = "disabled".
#
# Client values come from Firebase Console > Project settings > Your apps.
# They are public by design (not secrets); they are kept out of Git only so
# two branches cannot silently point at different projects. Leave them blank
# here — never commit real values.
# ---------------------------------------------------------------------
# FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=


# ---------------------------------------------------------------------
# AI service
#
# The backend is the only caller of the Python service; the collector app
# must never call it directly (AGENTS.md section 2).
# ---------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ANALYZE_PATH=/api/v1/analyze
AI_SERVICE_CRITICAL_MINERAL_PATH=/api/v1/critical-mineral/check
AI_SERVICE_HEALTH_PATH=/health
AI_SERVICE_TIMEOUT_MS=15000
AI_MAX_IMAGE_BYTES=10485760

# Circuit breaker: stop calling a failing AI service for a cool-down window.
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_MS=30000

# ---------------------------------------------------------------------
# Uploads
#
# Images are resized and re-encoded on-device before upload (AGENTS.md
# section 6), so this is a backstop rather than the expected size.
# ---------------------------------------------------------------------
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/heic,image/heif

# ---------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=25
PAGINATION_MAX_LIMIT=100

# ---------------------------------------------------------------------
# Rate limiting (in-process limiter, see middleware/rate-limit.js)
#
# authPerMinute is deliberately low: it is the only thing slowing down
# online guessing against POST /api/auth/firebase/sign-in.
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# ---------------------------------------------------------------------
# Logging
#
# silent | debug | info | warn | error
#
# Redaction needs no configuration: logger.js masks any value whose key
# matches pass|secret|token|authorization|cookie|api-key|credential|otp —
# which covers idToken — plus anything shaped like a JWT.
# ---------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Tests
#
# The integration suite TRUNCATEs tables. Never point this at a database you
# care about. tests/setup.js refuses to run if DATABASE_URL is also set to
# something different, so an accidental overlap fails loudly.
#
# Run migrations against it first: DATABASE_URL=$TEST_DATABASE_URL npm run migrate
# ---------------------------------------------------------------------
# TEST_DATABASE_URL=postgres://localhost/kabadiwala_test
